<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET permission needed: sync goes through the SAF content:// tree the user picks
         (ActivityResultContracts.OpenDocumentTree), so any network I/O happens inside the app
         that backs that folder (e.g. Google Drive), not this process. ACCESS_NETWORK_STATE is
         still required for WorkManager's NetworkType.CONNECTED sync constraint. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the app hand a downloaded version-named APK to the system installer. Android still forces
         a user-facing "Install this app?" confirmation for any APK outside the Play Store; this
         permission only lets that installer screen be launched, it cannot skip the confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FieldNote">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
