<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No INTERNET permission needed: sync goes through the SAF content:// tree the user picks
         (ActivityResultContracts.OpenDocumentTree), so any network I/O happens inside the app
         that backs that folder (e.g. Google Drive), not this process. ACCESS_NETWORK_STATE is
         still required for WorkManager's NetworkType.CONNECTED sync constraint. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FieldNote">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
